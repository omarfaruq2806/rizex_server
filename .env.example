NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rizex_db?schema=public

# Auth
BETTER_AUTH_SECRET=your_super_secret_key_here_min_32_characters
BETTER_AUTH_URL=http://localhost:5000

# Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=rizex-storage
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

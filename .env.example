# ==========================================
# RizeX Server Production & Development Environment
# ==========================================

# 1. Environment & Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# 2. CORS & Client Security
# Primary Frontend Client URL
CLIENT_URL=http://localhost:3000
# Comma-separated list of additional allowed origins for production CORS
ALLOWED_ORIGINS=https://rizex.vercel.app,https://yourcustomdomain.com

# 3. Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rizex_db?schema=public

# 4. Authentication (Better Auth)
# Generate a strong 32+ character random string (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=dev_secret_key_rizex_12345678901234567890
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth Credentials (Optional for social login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 5. Cloudflare R2 / S3 Storage (For Secure File Uploads)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=rizex-storage
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# 6. Observability, Logging & Error Tracking (Optional)
# Leave empty for local logging mode; provide Sentry DSN for live production bug tracking
SENTRY_DSN=https://2d568e7a1e48805a43cd8d2e71327f26@o4512231037861888.ingest.us.sentry.io/4512231062962176

